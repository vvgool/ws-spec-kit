{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "builtin.application-artifact-create-input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "workItemId",
    "stepId",
    "attemptId",
    "leaseToken",
    "artifactType",
    "contentFile"
  ],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "workItemId": {
      "type": "string",
      "pattern": "^WSS-[A-Za-z0-9-]+$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}(?::[1-9][0-9]*:[a-z][a-z0-9-]{0,62})?$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt-.+$"
    },
    "leaseToken": {
      "type": "string",
      "minLength": 1
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "outputId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "contentFile": {
      "type": "string",
      "minLength": 1
    }
  }
}
