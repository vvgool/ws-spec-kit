#!/usr/bin/env node
import { appendFileSync, existsSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import path from "node:path";
import process from "node:process";

const argv = process.argv.slice(2);
let stdin = "";
for await (const chunk of process.stdin) stdin += chunk;
const input = JSON.parse(stdin || "{}");
const root = process.env.HOME;
if (!root) throw new Error("fixture HOME missing");
const statePath = path.join(root, "github-state.json");
const callsPath = path.join(root, "github-calls.ndjson");
const timelinePath = path.join(root, "timeline.ndjson");
const state = JSON.parse(readFileSync(statePath, "utf8"));
appendFileSync(callsPath, `${JSON.stringify({ argv, input })}\n`);

const endpointIndex = argv.indexOf("--method");
const method = endpointIndex < 0 ? undefined : argv[endpointIndex + 1];
const endpoint = endpointIndex < 0 ? undefined : argv[endpointIndex + 2];
const issueEndpoint = "repos/acme/widget/issues/7";
const failOnce = path.join(root, "github-readback-fail-once");
const failAlways = path.join(root, "github-readback-fail-always");
function marker(stage, point) {
  return path.join(root, `github-${stage}-${point}`);
}

function consume(stage, point) {
  const filename = marker(stage, point);
  if (!existsSync(filename)) return false;
  renameSync(filename, `${filename}.consumed`);
  return true;
}

function preSendFailure() {
  for (const stage of ["issue.update", "issue.close"]) {
    if (consume(stage, "pre-send")) return true;
  }
  return false;
}

function armReadbackFailure(stage) {
  if (consume(stage, "readback-once")) writeFileSync(failOnce, "armed\n");
  if (consume(stage, "readback-always")) writeFileSync(failAlways, "armed\n");
}

function issue() {
  return {
    number: 7,
    node_id: "I_fixture_github_7",
    html_url: "https://github.example.com/acme/widget/issues/7",
    title: state.title,
    body: state.body,
    state: state.state,
    labels: [],
    updated_at: "2026-08-20T01:02:03Z",
    user: { login: "fixture-author" },
    assignees: [],
  };
}

if (argv.length === 1 && argv[0] === "--version") {
  process.stdout.write("gh version 2.80.0\n");
} else if (argv.join("\0") === ["auth", "status", "--active"].join("\0")) {
  process.stdout.write("authenticated\n");
} else if (method === "GET" && endpoint === issueEndpoint) {
  if (preSendFailure()) {
    process.stderr.write("fixture crashed before mutation\n");
    process.exitCode = 1;
  } else if (existsSync(failAlways)) {
    process.stderr.write("fixture readback unavailable\n");
    process.exitCode = 1;
  } else if (existsSync(failOnce)) {
    renameSync(failOnce, `${failOnce}.consumed`);
    process.stderr.write("fixture readback crashed\n");
    process.exitCode = 1;
  } else {
    process.stdout.write(JSON.stringify(issue()));
  }
} else if (method === "PATCH" && endpoint === issueEndpoint && typeof input.body === "string") {
  state.body = input.body;
  writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
  appendFileSync(timelinePath, `${JSON.stringify({ stage: "issue.update", provider: "github" })}\n`);
  armReadbackFailure("issue.update");
  if (consume("issue.update", "post-send")) {
    process.stderr.write("fixture crashed after mutation\n");
    process.exitCode = 1;
  } else process.stdout.write(JSON.stringify(issue()));
} else if (method === "PATCH" && endpoint === issueEndpoint && input.state === "closed") {
  state.state = "closed";
  writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
  appendFileSync(timelinePath, `${JSON.stringify({ stage: "issue.close", provider: "github" })}\n`);
  armReadbackFailure("issue.close");
  if (consume("issue.close", "post-send")) {
    process.stderr.write("fixture crashed after mutation\n");
    process.exitCode = 1;
  } else process.stdout.write(JSON.stringify(issue()));
} else {
  process.stderr.write("unexpected github fixture request\n");
  process.exitCode = 9;
}
