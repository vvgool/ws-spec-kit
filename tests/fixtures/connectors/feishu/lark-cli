#!/usr/bin/env node
import { appendFileSync, existsSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import path from "node:path";
import process from "node:process";

const argv = process.argv.slice(2);
let stdin = "";
for await (const chunk of process.stdin) stdin += chunk;
JSON.parse(stdin || "{}");
const root = process.env.HOME;
if (!root) throw new Error("fixture HOME missing");
const sourcePath = path.join(root, "feishu-source.json");
const publishedPath = path.join(root, "feishu-published.json");
const callsPath = path.join(root, "feishu-calls.ndjson");
const timelinePath = path.join(root, "timeline.ndjson");
const markdownIndex = argv.indexOf("--markdown");
const logged = argv.map((value, index) => index === markdownIndex + 1 ? "<redacted>" : value);
appendFileSync(callsPath, `${JSON.stringify({ argv: logged })}\n`);

const flag = (name) => {
  const index = argv.indexOf(name);
  return index < 0 ? undefined : argv[index + 1];
};
const command = argv.slice(0, 2).join(" ");
const document = flag("--doc");
const failOnce = path.join(root, "feishu-readback-fail-once");
const failAlways = path.join(root, "feishu-readback-fail-always");
const armOnce = path.join(root, "feishu-arm-readback-fail-once");
const armAlways = path.join(root, "feishu-arm-readback-fail-always");

function armReadbackFailure() {
  if (existsSync(armOnce)) renameSync(armOnce, failOnce);
  if (existsSync(armAlways)) renameSync(armAlways, failAlways);
}

function response(token, value) {
  return {
    doc_id: token,
    doc_url: `https://tenant.feishu.cn/docx/${token}`,
    title: value.title,
    markdown: value.markdown,
    has_more: false,
    owner: "fixture-owner",
    revision: "1",
    space: "delivery",
    updated_at: "2026-08-20T03:04:05Z",
  };
}

if (argv.length === 1 && argv[0] === "--version") {
  process.stdout.write("lark-cli version 1.0.0\n");
} else if (command === "docs +fetch" && document === "sourceDocumentToken123") {
  process.stdout.write(JSON.stringify(response(document, JSON.parse(readFileSync(sourcePath, "utf8")))));
} else if (command === "docs +fetch" && document === "createdDocumentToken123") {
  if (existsSync(failAlways)) {
    process.stderr.write("fixture readback unavailable\n");
    process.exitCode = 1;
  } else if (existsSync(failOnce)) {
    renameSync(failOnce, `${failOnce}.consumed`);
    process.stderr.write("fixture readback crashed\n");
    process.exitCode = 1;
  } else {
    process.stdout.write(JSON.stringify(response(document, JSON.parse(readFileSync(publishedPath, "utf8")))));
  }
} else if (command === "docs +create" && flag("--folder-token") === "folderFixtureToken123") {
  const value = { title: flag("--title"), markdown: flag("--markdown") };
  writeFileSync(publishedPath, `${JSON.stringify(value, null, 2)}\n`);
  appendFileSync(timelinePath, `${JSON.stringify({ stage: "knowledge.publish", provider: "feishu" })}\n`);
  armReadbackFailure();
  process.stdout.write(JSON.stringify({
    doc_id: "createdDocumentToken123",
    doc_url: "https://tenant.feishu.cn/docx/createdDocumentToken123",
  }));
} else {
  process.stderr.write("unexpected feishu fixture request\n");
  process.exitCode = 9;
}
