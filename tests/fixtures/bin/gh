#!/usr/bin/env node
import process from "node:process";

const argv = process.argv.slice(2);
const endpoint = argv[argv.indexOf("--method") + 2];
let input = "";
for await (const chunk of process.stdin) input += chunk;
JSON.parse(input || "{}");

if (argv.length === 1 && argv[0] === "--version") {
  process.stdout.write("gh version 2.80.0\n");
} else if (argv.join("\0") === ["auth", "status", "--active"].join("\0")) {
  process.stdout.write("authenticated\n");
} else if (endpoint?.includes("not-found")) {
  process.stderr.write("HTTP 404: issue not found\n");
  process.exitCode = 1;
} else if (endpoint?.includes("unauthorized")) {
  process.stderr.write("HTTP 401: authentication required\n");
  process.exitCode = 1;
} else if (endpoint?.includes("forbidden")) {
  process.stderr.write("HTTP 403: forbidden\n");
  process.exitCode = 1;
} else if (endpoint?.includes("rate-limited")) {
  process.stderr.write("HTTP 403: API rate limit exceeded\n");
  process.exitCode = 1;
} else if (endpoint?.includes("drift")) {
  process.stdout.write(JSON.stringify({ number: "7", node_id: 99 }));
} else if (endpoint === "repos/acme/widget/issues/7") {
  process.stdout.write(JSON.stringify({
    url: "https://github.example.com/api/v3/repos/acme/widget/issues/7",
    repository_url: "https://github.example.com/api/v3/repos/acme/widget",
    labels_url: "https://github.example.com/api/v3/repos/acme/widget/issues/7/labels{/name}",
    comments_url: "https://github.example.com/api/v3/repos/acme/widget/issues/7/comments",
    events_url: "https://github.example.com/api/v3/repos/acme/widget/issues/7/events",
    id: 7001,
    number: 7,
    node_id: "I_kwDOStableNode",
    html_url: "https://github.example.com/acme/widget/issues/7",
    title: "Ship the connector",
    body: "Read the issue body.",
    state: "open",
    locked: false,
    labels: [
      { id: 7101, node_id: "LA_connector", url: "https://github.example.com/api/v3/repos/acme/widget/labels/connector", name: "connector", color: "0052cc", default: false, description: "Connector work" },
      { id: 7102, node_id: "LA_ready", url: "https://github.example.com/api/v3/repos/acme/widget/labels/ready", name: "ready", color: "0e8a16", default: false, description: "Ready for delivery" }
    ],
    comments: 2,
    created_at: "2026-08-18T01:02:03Z",
    updated_at: "2026-08-19T01:02:03Z",
    closed_at: null,
    user: { login: "octocat", id: 7201, node_id: "U_octocat", avatar_url: "https://avatars.example.com/7201", type: "User", site_admin: false },
    assignees: [{ login: "maintainer", id: 7202, node_id: "U_maintainer", avatar_url: "https://avatars.example.com/7202", type: "User", site_admin: false }],
    author_association: "MEMBER"
  }));
} else {
  process.stderr.write("unexpected fixture argv\n");
  process.exitCode = 9;
}
