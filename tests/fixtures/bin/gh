#!/usr/bin/env node
import process from "node:process";

const argv = process.argv.slice(2);
const endpoint = argv[argv.indexOf("--method") + 2];
let input = "";
for await (const chunk of process.stdin) input += chunk;
JSON.parse(input || "{}");

if (argv.length === 1 && argv[0] === "--version") {
  process.stdout.write("gh version 2.80.0\n");
} else if (argv.join("\0") === ["auth", "status", "--active"].join("\0")) {
  process.stdout.write("authenticated\n");
} else if (endpoint?.includes("not-found")) {
  process.stderr.write("HTTP 404: issue not found\n");
  process.exitCode = 1;
} else if (endpoint?.includes("unauthorized")) {
  process.stderr.write("HTTP 401: authentication required\n");
  process.exitCode = 1;
} else if (endpoint?.includes("forbidden")) {
  process.stderr.write("HTTP 403: forbidden\n");
  process.exitCode = 1;
} else if (endpoint?.includes("rate-limited")) {
  process.stderr.write("HTTP 403: API rate limit exceeded\n");
  process.exitCode = 1;
} else if (endpoint?.includes("drift")) {
  process.stdout.write(JSON.stringify({ number: "7", node_id: 99 }));
} else if (endpoint === "repos/acme/widget/issues/7") {
  process.stdout.write(JSON.stringify({
    number: 7,
    node_id: "I_kwDOStableNode",
    html_url: "https://github.example.com/acme/widget/issues/7",
    title: "Ship the connector",
    body: "Read the issue body.",
    state: "open",
    labels: [{ name: "connector" }, { name: "ready" }],
    updated_at: "2026-08-19T01:02:03Z",
    user: { login: "octocat" },
    assignees: [{ login: "maintainer" }]
  }));
} else {
  process.stderr.write("unexpected fixture argv\n");
  process.exitCode = 9;
}
